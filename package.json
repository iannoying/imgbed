{
  "name": "imgbed",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-friendly image hosting on Cloudflare Workers + R2 + D1",
  "type": "module",
  "bin": { "imgbed": "scripts/imgbed.mjs" },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply imgbed --local",
    "db:migrate:remote": "wrangler d1 migrations apply imgbed --remote",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/smoke-test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.163.0"
  }
}
