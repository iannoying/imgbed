{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imgbed",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },

  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "imgbed" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "imgbed",
      // `npx wrangler d1 create imgbed` 之后把输出的 database_id 填到这里
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // 图片对外链接的前缀，绑定自定义域名后填，例如 "https://img.example.com"
    // 留空则使用请求的域名
    "PUBLIC_BASE_URL": "",
    "MAX_UPLOAD_MB": "20"
  }

  // 绑定自定义域名（域名需托管在 Cloudflare）：
  // ,"routes": [{ "pattern": "img.example.com", "custom_domain": true }]
}
